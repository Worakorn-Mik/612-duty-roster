# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key — อ่านข้อมูลได้อย่างเดียว (ผ่าน RLS) ปลอดภัยที่จะอยู่ฝั่ง browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role / secret key — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit เด็ดขาด (ข้าม RLS ได้)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Admin ----------
# PIN สำหรับทีมงานห้อง 612 — แนะนำอย่างน้อย 8 ตัวอักษร
ADMIN_PIN=change-me-8-chars-min
# สตริงสุ่มยาว ๆ ใช้เซ็นคุกกี้ session ของ Admin  (สร้างด้วย: openssl rand -base64 32)
ADMIN_SESSION_SECRET=change-me-random-32-bytes
